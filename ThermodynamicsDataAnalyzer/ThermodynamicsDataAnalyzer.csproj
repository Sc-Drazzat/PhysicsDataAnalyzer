<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>PhysicsDataAnalyzer</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <Folder Include="Data\reports\" />
    </ItemGroup>

    <ItemGroup>
      <None Include="native\energy\build\macos-arm64\libpda_energy.dylib" Link="libpda_energy.dylib" CopyToOutputDirectory="PreserveNewest" Condition="Exists('native\energy\build\macos-arm64\libpda_energy.dylib')" />
      <None Include="native\energy\build\windows-x64\pda_energy.dll" Link="pda_energy.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('native\energy\build\windows-x64\pda_energy.dll')" />
    </ItemGroup>

</Project>
